# Copy to .env for local development (`cargo run` reads it).
DATABASE_URL=postgres://opentempus:opentempus@localhost:5432/opentempus
OPENTEMPUS_LISTEN=127.0.0.1:8080
OPENTEMPUS_PUBLIC_URL=http://localhost:8080
OPENTEMPUS_ALLOW_REGISTRATION=true
# OPENTEMPUS_SYNC_CONCURRENCY=4
# OPENTEMPUS_SCHEDULER_TICK_SECS=30
# OPENTEMPUS_SESSION_TTL_DAYS=30
# OPENTEMPUS_SECURE_COOKIES=false
RUST_LOG=info,sqlx=warn
